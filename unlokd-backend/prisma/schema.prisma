generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ChatType {
  DIRECT
  GROUP
}

enum ChatMemberRole {
  OWNER
  MEMBER
}

enum MessageContentType {
  TEXT
}

enum MessageVisibilityType {
  PLAIN
}

enum MessageStatus {
  UNLOCKED
  PENDING
}

model User {
  id            BigInt   @id @default(autoincrement())
  email         String   @unique @db.VarChar(100)
  username      String   @unique @db.VarChar(50)
  password_hash String   @db.VarChar(255)
  display_name  String   @db.VarChar(255)
  avatar_url    String?  @db.VarChar(255)
  presence_status String? @db.VarChar(50)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  last_login_at DateTime?

  contacts      Contact[] @relation("UserContactsOwner")
  contactOf     Contact[] @relation("UserContactsContact")
  chatsCreated  Chat[]    @relation("UserChatsCreated")
  chatMembers   ChatMember[]
  messagesSent  Message[] @relation("UserMessagesSent")

  @@map("users")
}

model Contact {
  id              BigInt   @id @default(autoincrement())
  owner_user_id   BigInt
  contact_user_id BigInt
  alias           String?  @db.VarChar(50)
  created_at      DateTime @default(now())

  owner   User @relation("UserContactsOwner", fields: [owner_user_id], references: [id])
  contact User @relation("UserContactsContact", fields: [contact_user_id], references: [id])

  @@unique([owner_user_id, contact_user_id])
  @@index([owner_user_id])
  @@map("contacts")
}

model Chat {
  id         BigInt    @id @default(autoincrement())
  public_id  String    @unique @db.VarChar(255)
  type       ChatType
  title      String?   @db.VarChar(255)
  created_by BigInt
  created_at DateTime  @default(now())

  creator   User         @relation("UserChatsCreated", fields: [created_by], references: [id])
  members   ChatMember[]
  messages  Message[]

  @@index([created_by])
  @@map("chats")
}

model ChatMember {
  chat_id      BigInt
  user_id      BigInt
  role         ChatMemberRole
  joined_at    DateTime  @default(now())
  last_read_at DateTime?

  chat Chat @relation(fields: [chat_id], references: [id])
  user User @relation(fields: [user_id], references: [id])

  @@id([chat_id, user_id])
  @@index([user_id])
  @@map("chat_members")
}

model Message {
  id              BigInt               @id @default(autoincrement())
  chat_id         BigInt
  sender_id       BigInt
  content_type    MessageContentType
  content_text    String?              @db.Text
  visibility_type MessageVisibilityType
  status          MessageStatus
  created_at      DateTime             @default(now())
  updated_at      DateTime             @updatedAt

  chat   Chat @relation(fields: [chat_id], references: [id])
  sender User @relation("UserMessagesSent", fields: [sender_id], references: [id])

  @@index([chat_id])
  @@index([sender_id])
  @@index([chat_id, created_at])
  @@map("messages")
}
